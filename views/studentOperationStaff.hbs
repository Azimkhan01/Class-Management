<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
        integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/public/CascadingStyle/studentOperationStaff.css" />
    <link rel="stylesheet" href="/public/CascadingStyle/staffNavbar.css" />
</head>

<body>
    {{>staffNavbar}}
    <div class="container">
        <div class="staffHandler">
            <div>
                <p>Add Student</p>
            </div>
            <div>
                <button id="addStudent">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>
        <div id="studentForm">
            <form action="/studentForm" method="post" enctype="multipart/form-data">
                <div class="form-group">
                <input type="text" id="studentName" name="studentName" placeholder="Student Name" required>
            </div>
            <div class="form-group">
                <input type="number" id="studentAge" name="studentAge" placeholder="Student Age" required>
            </div>
            <div class="form-group">
                {{!-- <label for="gender">Gender</label> --}}
                <select id="gender" name="gender" required>
                    <option value disabled selected>Select Gender</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="form-group">
                <select  id="studentClass" name="studentClass" required>
                     {{!-- <option value disabled selected>Select Class</option> --}}
                </select>
            </div>
            <div class="form-group">
                {{!-- <label for="batch">Batch</label> --}}
                <select id="batch" name="batchName" required>
                    {{!-- <option value disabled selected>Select Batch</option> --}}
                    {{!-- <option value="batch1">Batch 1</option>
                    <option value="batch2">Batch 2</option>
                    <option value="batch3">Batch 3</option> --}}
                </select>
            </div>
            <div class="form-group">
                {{!-- <label for="previousGrade">Previous Year
                    Grade/Percentage</label> --}}
                <input type="text" id="previousGrade" name="previousGrade" placeholder="Enter Previous Year Grade/Percentage"
                    required>
            </div>
            <div class="form-group">
                <input type="tel" id="parentWhatsapp" name="parentWhatsapp" placeholder="Parent's WhatsApp Number"
                    pattern="[0-9]{10}" required>
            </div>
             <div class="form-group">
                <input type="tel" id="studentWhatsapp" name="studentWhatsapp" placeholder="Student's WhatsApp Number"
                    pattern="[0-9]{10}" required>
            </div>
            <div class="form-group">
                <input type="email" id="parentEmail" name="parentEmail" placeholder="Parent's Email" required>
            </div>
             <div class="form-group">
                <input type="text" id="note" name="note" placeholder="Enter Note related to remark of fees and anything you want to specify" required>
            </div>
            <div class="form-group">
                {{!-- <label for="studentImage">Upload Student
                    Image</label>z` --}}
                <input type="file" id="studentImage" name="studentImage" accept="image/*" required>
            </div>
            <div class="form-group">
                <button id="studentSubmit">Submit</button>
            </div>
            </form>
        </div>
        <div class="staffHandler">
            <div>
                <p>Add Batch</p>
            </div>
            <div>
                <button id="addBatch">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>
        <div id="batchForm">
            {{!-- <form id="batchFormElement"> --}}
                <div class="form-group">
                    <input type="number" id="batchStandard" name="batchstandard" placeholder="Batch Standard" required>

                </div>
                <div class="form-group">
                    <input type="text" id="batchName" name="batchName" placeholder="Batch Name" required>

                </div>
                <div class="form-group">
                    <input type="number" id="batchYear" name="batchYear" placeholder="Batch Year" required>

                </div>
                <div class="form-group">
                    <label for="startDate">Start Date</label>
                    <input type="date" id="startDate" name="startDate" required>

                </div>
                <div class="form-group">
                    <label for="endDate">End Date</label>
                    <input type="date" id="endDate" name="endDate" required>
                </div>
                <div class="form-group">
                    <button id="batchSubmit">Submit</button>
                </div>
                {{!--
            </form> --}}

        </div>

        <div class="staffHandler">
            <div>
                <p>Batch</p>
            </div>
            <div>
                <button id="ShowBatches">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>
        <div id="TotalBatches">
            <div class="card">
                <div class="Name-standard">
                    <div class="name">
                        <p>Batch Name:</p>
                    </div>
                    <div class="standard">
                        <p>Batch Standard:</p>
                    </div>
                </div>
                <div class="year">
                    <p class="year">
                        Year:
                    </p>
                </div>
                <div class="start-end">
                    <div class="start">
                        <p>Start Date:</p>
                    </div>
                    <div class="end">
                        <p>End Date:</p>
                    </div>
                </div>
                <div onclick="handleDeleteBatch(id)">
                    <button class="delete">Delete</button>
                </div>
            </div>
        </div>
    </div>
    {{!-- error handling div not of any use at start becauise it not visible
    --}}
    <div id="error">
        <div class="info">
            <div class="info__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" viewBox="0 0 24 24" height="24" fill="none">
                    <path fill="#393a37"
                        d="m12 1.5c-5.79844 0-10.5 4.70156-10.5 10.5 0 5.7984 4.70156 10.5 10.5 10.5 5.7984 0 10.5-4.7016 10.5-10.5 0-5.79844-4.7016-10.5-10.5-10.5zm.75 15.5625c0 .1031-.0844.1875-.1875.1875h-1.125c-.1031 0-.1875-.0844-.1875-.1875v-6.375c0-.1031.0844-.1875.1875-.1875h1.125c.1031 0 .1875.0844.1875.1875zm-.75-8.0625c-.2944-.00601-.5747-.12718-.7808-.3375-.206-.21032-.3215-.49305-.3215-.7875s.1155-.57718.3215-.7875c.2061-.21032.4864-.33149.7808-.3375.2944.00601.5747.12718.7808.3375.206.21032.3215.49305.3215.7875s-.1155.57718-.3215.7875c-.2061.21032-.4864.33149-.7808.3375z">
                    </path>
                </svg>
            </div>
            <div id="error-message" class="info__title">lorem ipsum dolor
                sit amet</div>
            <div id="remove-error" class="info__close"><svg height="20" viewBox="0 0 20 20" width="20"
                    xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="m15.8333 5.34166-1.175-1.175-4.6583 4.65834-4.65833-4.65834-1.175 1.175 4.65833 4.65834-4.65833 4.6583 1.175 1.175 4.65833-4.6583 4.6583 4.6583 1.175-1.175-4.6583-4.6583z"
                        fill="#393a37"></path>
                </svg></div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/js/regular.min.js"
        integrity="sha512-TjMd9u2haGIV8ZYBQDPyGJfei5Gc2U7iw1lnCu1Z2DHlTcirZ8c6nEvSixFDc3rRNQfSptbS7rF1m7bLf8wxbg=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="/public/Script/studentOperationStaff.js"></script>
    <script src="/public/Script/staffNavbar.js"></script>
</body>

</html>